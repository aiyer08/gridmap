# GridMap runs with none of these set — it falls back to modelled grid
# profiles, and impact history always lives in the browser's localStorage
# (there is no account and no database). See README.md to get started, and
# docs/DEPLOYMENT.md for the full Vercel deployment runbook.

# EIA API v2 — free, instant: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Electricity Maps — live intensity + 24h forecast (optional)
# https://portal.electricitymaps.com/
ELECTRICITY_MAPS_TOKEN=

# WattTime — independent marginal-emissions cleanliness ranking (optional).
# https://docs.watttime.org/ · free tier is entitled to ONE grid region.
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
# Or a pre-issued bearer token instead of the pair above — but WattTime's
# tokens expire 30 minutes after issue, so a token-only setup works once and
# then silently falls back to the model. Prefer the username/password pair
# above; the app mints a fresh token per request when both are set.
WATTTIME_API_TOKEN=
