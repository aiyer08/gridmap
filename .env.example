# GridMap runs with none of these set — it falls back to modelled grid
# profiles and localStorage-only tracking. See README.md to get started, and
# docs/DEPLOYMENT.md for the full Supabase + Vercel deployment runbook.

# EIA API v2 — free, instant: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Electricity Maps — live intensity + 24h forecast (optional)
# https://portal.electricitymaps.com/
ELECTRICITY_MAPS_TOKEN=

# WattTime — cleanliness percentile + forecast (optional)
# https://docs.watttime.org/
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
# Or a pre-issued bearer token instead of the pair above. Note WattTime tokens
# expire 30 minutes after issue, so this only suits a quick trial.
WATTTIME_API_TOKEN=

# Supabase (optional until we deploy — the app works with local storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
